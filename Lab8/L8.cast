[797.890076, "o", "\u001b(B\u001b[0;7m[ Reading... ]\u001b(B\u001b[m\u001b[22;40H\u001b(B\u001b[0;7m[ Read 20 lines ]\u001b(B\u001b[m\u001b[H\u001b(B\u001b[0;7m  GNU nano 8.4                               Dockerfile                                        \u001b[1;94H\u001b(B\u001b[m\r\u001b[23d\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Help\u001b[23;16H\u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out   \u001b(B\u001b[0;7m^F\u001b(B\u001b[m Where Is    \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut\u001b[23;61H\u001b(B\u001b[0;7m^T\u001b(B\u001b[m Execute     \u001b(B\u001b[0;7m^C\u001b(B\u001b[m Location\r\u001b[24d\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[24;16H\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File   \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace     \u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste\u001b[61G\u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify     \u001b(B\u001b[0;7m^/\u001b(B\u001b[m Go To Line\r\u001b[2dFrom docker.io/library/debian:bookworm-slim\r\u001b[4d\u001b[36m# Install GCC and make\r\u001b[5d\u001b[39m\u001b(B\u001b[mRUN apt-get update && \\\u001b[6;8H\u001b[38;5;208m\u001b[1K \u001b[39m\u001b(B\u001b[mapt-get install -y --no-install-recommends build-essential && \\\u001b[7;8H\u001b[38;5;208m\u001b[1K \u001b[39m\u001b(B\u001b[mrm -f /var/lib/apt/lists/*\r\u001b[9d\u001b[36m#Working directory in container\r\u001b[10d\u001b[39m\u001b(B\u001b[mWORKDIR /app\r\u001b[12d\u001b[36m# Copy Lab 4 source files and MakeFile\r\u001b[13d\u001b[39m\u001b(B\u001b[mCOPY fibonacci.c main.c test_fibonacci.c makefile ./\r\u001b[14dCOPY headers/ ./headers/\r\u001b[16d\u001b[36m#Compiling Fibonacci and run unit tests\r\u001b[17d\u001b[39m\u001b(B\u001b[mRUN make && make test\r\u001b[19d\u001b[36m# Run unit tests when container starts\r\u001b[20d\u001b[39m\u001b(B\u001b[mCMD [\"./test_fibonacci\"]\r\u001b[2d\u001b[?12l\u001b[?25h"]
