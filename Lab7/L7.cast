[12487.346991, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\bnano hosts.ini\u001b[K"]
[12488.014078, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\bls\u001b[K"]
[12488.359791, "o", "\b\bsudo grep -iE '^\\s*INSTALL_LOCK\\s*=' /etc/gitea/app.ini"]
[12488.598857, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b-u git test -r /etc/gitea/app.ini && echo \"Config readable\" || echo \"Config Not readable\""]
[12489.367328, "o", "\u001b[A\r\u001b]0;ehtsham@Debian-arm-Lab: ~/Ehtsham_Aziz/Lab7\u0007\u001b[01;32mehtsham@Debian-arm-Lab\u001b[00m:\u001b[01;34m~/Ehtsham_Aziz/Lab7\u001b[00m$ \u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[26Pgrep -iE '^\\s*INSTALL_LOCK\\s*=' /etc/gitea/app.ini\r\n\r\u001b[K\u001b[A\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C"]
[12490.3058, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b-u git test -r /etc/gitea/app.ini && echo \"Config readable\" || echo \"Config Not readable\""]
[12490.526328, "o", "\u001b[A\r\u001b]0;ehtsham@Debian-arm-Lab: ~/Ehtsham_Aziz/Lab7\u0007\u001b[01;32mehtsham@Debian-arm-Lab\u001b[00m:\u001b[01;34m~/Ehtsham_Aziz/Lab7\u001b[00m$ \u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[Cenv HOME =/home/git GITEA_WORK_DIR=/var/lib/gitea /usr/local/bin/gitea --config /etc/gitea/app.ini actions generate-runner-token > /dev/null"]
