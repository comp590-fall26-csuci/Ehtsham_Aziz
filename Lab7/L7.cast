[8476.842246, "o", "\r\n"]
[8476.979476, "o", "\r\nPLAY [Lab7 - Install Gitea and Gitea Runner on Debian] **********************************************************************\r\n"]
[8476.984016, "o", "\r\nTASK [Verify debian ARM64 system] *******************************************************************************************\r\n"]
[8477.189477, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[8477.190827, "o", "\r\nTASK [Install dependencies for Gitea and Fibonacci jobs] ********************************************************************\r\n"]
[8477.994766, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[8477.995734, "o", "\r\nTASK [Create git service user] **********************************************************************************************\r\n"]
[8478.213327, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[8478.213914, "o", "\r\nTASK [Create runner service user] *******************************************************************************************\r\n"]
[8478.369269, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[8478.369881, "o", "\r\nTASK [Create Gitea Data Directories] ****************************************************************************************\r\n"]
[8478.550221, "o", "\u001b[0;32mok: [localhost] => (item=/var/lib/gitea)\u001b[0m\r\n"]
[8478.67809, "o", "\u001b[0;32mok: [localhost] => (item=/var/lib/gitea/custom)\u001b[0m\r\n"]
[8478.819045, "o", "\u001b[0;32mok: [localhost] => (item=/var/lib/gitea/data)\u001b[0m\r\n"]
[8478.961888, "o", "\u001b[0;32mok: [localhost] => (item=/var/lib/gitea/data/gitea-repositories)\u001b[0m\r\n"]
[8479.094566, "o", "\u001b[0;32mok: [localhost] => (item=/var/lib/gitea/log)\u001b[0m\r\n"]
[8479.095896, "o", "\r\nTASK [Create Gitea Configuration directory] *********************************************************************************\r\n"]
[8479.232925, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[8479.233122, "o", "\r\nTASK [Create Runner Directories] ********************************************************************************************\r\n"]
[8479.369121, "o", "\u001b[0;32mok: [localhost] => (item=/var/lib/gitea-runner)\u001b[0m\r\n"]
[8479.499315, "o", "\u001b[0;32mok: [localhost] => (item=/var/lib/gitea-runner/work)\u001b[0m\r\n"]
[8479.50111, "o", "\r\nTASK [Create runner configuration Directory] ********************************************************************************"]
[8479.501136, "o", "\r\n"]
