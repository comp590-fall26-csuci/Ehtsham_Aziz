[13613.548421, "o", "\u001b[A\r\u001b]0;ehtsham@Debian-arm-Lab: ~/Ehtsham_Aziz/Lab7\u0007\u001b[01;32mehtsham@Debian-arm-Lab\u001b[00m:\u001b[01;34m~/Ehtsham_Aziz/Lab7\u001b[00m$ \u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[Cenv HOME =/home/git GITEA_WORK_DIR=/var/lib/gitea /usr/local/bin/gitea --config /etc/gitea/app.ini actions generate-runner-token > /dev/null"]
