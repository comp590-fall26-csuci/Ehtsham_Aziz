[11016.030477, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[11016.031275, "o", "\r\nTASK [Enable and start Gitea] ***********************************************************************************************\r\n"]
[11016.504775, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
