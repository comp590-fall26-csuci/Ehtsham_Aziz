[12403.910355, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\bnano hosts.ini\u001b[K"]
[12404.114678, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\bls\u001b[K"]
