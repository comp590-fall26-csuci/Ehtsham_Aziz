[10069.532336, "o", "\r\u001b[2d\u001b(B\u001b[0;1m\u001b[33m- \u001b(B\u001b[0m\u001b[92mname\u001b[39m: \u001b(B\u001b[mLab7 - Install Gitea and Gitea Runner on Debian\u001b[3;3H\u001b[92mhosts\u001b[39m: \u001b(B\u001b[mall\u001b[4;3H\u001b[92mbecome\u001b[39m: \u001b[95mtrue\u001b[5;3H\u001b[92mgather_facts\u001b[39m: \u001b[95mfalse\u001b[7;3H\u001b[92mvars\u001b[39m:\u001b[8;5H\u001b[92mgitea_version\u001b[39m: \u001b[95m'28.3.0'\u001b[9;5H\u001b[92mrunner_version\u001b[39m: \u001b[95m'5.4.1'\u001b[10;5H\u001b[92mgitea_url\u001b[39m: \u001b[95m'https://127.0.0.1:3000'\u001b[12;3H\u001b[92mtasks\u001b[39m:\r\u001b[13d\u001b(B\u001b[0;1m\u001b[33m    - \u001b(B\u001b[0m\u001b[92mname\u001b[39m: \u001b(B\u001b[mVerify debian ARM64 system\u001b[14;7H\u001b[92mansible.builtin.shell\u001b[39m:\u001b(B\u001b[0;1m\u001b[38;5;38m |\u001b[15;9H\u001b[39m\u001b(B\u001b[mset -eu\u001b[16;9H. /etc/os-release\u001b[18;9Hif \u001b[33m[\u001b[39m\u001b(B\u001b[m \u001b[95m\"$ID\"\u001b[38;5;48m != \u001b[95m\"debian\"\u001b[39m\u001b(B\u001b[m \u001b[33m]\u001b[39m\u001b(B\u001b[m; then\u001b[19;11Hecho \u001b[95m\"ERROR: Debian is required\"\u001b[20;11H\u001b[39m\u001b(B\u001b[mexit 1\u001b[21;9Hfi\u001b[23d\b\bif \u001b[33m[\u001b[39m\u001b(B\u001b[m \u001b[95m\"$(uname -m)\"\u001b[38;5;48m != \u001b[95m\"aarch64\"\u001b[39m\u001b(B\u001b[m \u001b[33m]\u001b[39m\u001b(B\u001b[m; then\u001b[24;11Hecho \u001b[95m\"ERROR: ARM64 architecture is required\"\u001b[25;11H\u001b[39m\u001b(B\u001b[mexit 1\u001b[26;9Hfi\u001b[28d\b\becho \u001b[95m\"SUCCESS: Debian ARM64 verified\"\u001b[29;8H\u001b[39m\u001b[41m\u001b[1K\u001b[30d\b\u001b[49m\u001b[92mchanged_when\u001b[39m: \u001b[95mfalse\r\u001b[2d\u001b[39m\u001b(B\u001b[m\u001b[?12l\u001b[?25h"]
