[11013.130128, "o", "\u001b[0;32mok: [localhost] => (item=/var/lib/gitea/data/gitea-repositories)\u001b[0m\r\n"]
[11013.252154, "o", "\u001b[0;32mok: [localhost] => (item=/var/lib/gitea/log)\u001b[0m\r\n"]
[11013.253909, "o", "\r\nTASK [Create Gitea Configuration directory] *********************************************************************************\r\n"]
[11013.386631, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[11013.387332, "o", "\r\nTASK [Create Runner Directories] ********************************************************************************************\r\n"]
[11013.520046, "o", "\u001b[0;32mok: [localhost] => (item=/var/lib/gitea-runner)\u001b[0m\r\n"]
[11013.631014, "o", "\u001b[0;32mok: [localhost] => (item=/var/lib/gitea-runner/work)\u001b[0m\r\n"]
[11013.632735, "o", "\r\nTASK [Create runner configuration Directory] ********************************************************************************\r\n"]
[11013.751822, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[11013.752478, "o", "\r\nTASK [Download Verified Gitea Binary] ***************************************************************************************\r\n"]
[11014.329846, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[11014.330639, "o", "\r\nTASK [Download verified runner Binary] **************************************************************************************\r\n"]
[11014.833886, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[11014.834574, "o", "\r\nTASK [Generate Gitea secrets once] ******************************************************************************************\r\n"]
[11014.974065, "o", "\u001b[0;32mok: [localhost] => (item=(censored due to no_log))\u001b[0m\r\n"]
[11015.097347, "o", "\u001b[0;32mok: [localhost] => (item=(censored due to no_log))\u001b[0m\r\n"]
