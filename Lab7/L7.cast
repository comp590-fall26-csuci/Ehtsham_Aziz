[16516.513106, "o", "\r\nPLAY [Lab7 - Install Gitea and Gitea Runner on Debian] **********************************************************************\r\n"]
[16516.530535, "o", "\r\nTASK [Verify debian ARM64 system] *******************************************************************************************\r\n"]
[16516.793528, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[16516.794454, "o", "\r\nTASK [Install dependencies for Gitea and Fibonacci jobs] ********************************************************************\r\n"]
[16519.093824, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[16519.094739, "o", "\r\nTASK [Create git service user] **********************************************************************************************\r\n"]
[16519.319045, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[16519.319588, "o", "\r\nTASK [Create runner service user] *******************************************************************************************\r\n"]
[16519.49192, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[16519.492822, "o", "\r\nTASK [Create Gitea Data Directories] ****************************************************************************************\r\n"]
[16519.684667, "o", "\u001b[0;32mok: [localhost] => (item=/var/lib/gitea)\u001b[0m\r\n"]
[16519.834825, "o", "\u001b[0;32mok: [localhost] => (item=/var/lib/gitea/custom)\u001b[0m\r\n"]
[16519.962157, "o", "\u001b[0;32mok: [localhost] => (item=/var/lib/gitea/data)\u001b[0m\r\n"]
[16520.088806, "o", "\u001b[0;32mok: [localhost] => (item=/var/lib/gitea/data/gitea-repositories)\u001b[0m\r\n"]
[16520.232579, "o", "\u001b[0;32mok: [localhost] => (item=/var/lib/gitea/log)\u001b[0m\r\n"]
[16520.233802, "o", "\r\nTASK [Create Gitea Configuration directory] *********************************************************************************\r\n"]
[16520.384161, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[16520.385603, "o", "\r\nTASK [Create Runner Directories] ********************************************************************************************\r\n"]
[16520.537037, "o", "\u001b[0;32mok: [localhost] => (item=/var/lib/gitea-runner)\u001b[0m\r\n"]
[16520.666881, "o", "\u001b[0;32mok: [localhost] => (item=/var/lib/gitea-runner/work)\u001b[0m\r\n"]
[16520.668252, "o", "\r\nTASK [Create runner configuration Directory] ********************************************************************************\r\n"]
[16520.811184, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[16520.811645, "o", "\r\nTASK [Download Verified Gitea Binary] ***************************************************************************************\r\n"]
[16521.407783, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[16521.408587, "o", "\r\nTASK [Download verified runner Binary] **************************************************************************************\r\n"]
[16521.759892, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[16521.760632, "o", "\r\nTASK [Generate Gitea secrets once] ******************************************************************************************\r\n"]
[16521.898943, "o", "\u001b[0;32mok: [localhost] => (item=(censored due to no_log))\u001b[0m\r\n"]
[16522.004994, "o", "\u001b[0;32mok: [localhost] => (item=(censored due to no_log))\u001b[0m\r\n"]
[16522.006243, "o", "\r\nTASK [Generate OAuth2 JWT secret once] **************************************************************************************\r\n"]
[16522.131282, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[16522.131822, "o", "\r\nTASK [Read presisten Gitea secrets] *****************************************************************************************\r\n"]
[16522.312708, "o", "\u001b[0;32mok: [localhost] => (item=(censored due to no_log))\u001b[0m\r\n"]
[16522.42186, "o", "\u001b[0;32mok: [localhost] => (item=(censored due to no_log))\u001b[0m\r\n"]
[16522.555873, "o", "\u001b[0;32mok: [localhost] => (item=(censored due to no_log))\u001b[0m\r\n"]
[16522.557595, "o", "\r\nTASK [Configure Gitea SQLite and Actions] ***********************************************************************************\r\n"]
[16522.881091, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[16522.881755, "o", "\r\nTASK [Write Gitea systemd service] ******************************************************************************************\r\n"]
[16523.13806, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Enable and start Gitea] ***********************************************************************************************\r\n"]
[16523.62316, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[16523.627474, "o", "\r\nTASK [Wait until Gitea responds] ********************************************************************************************\r\n"]
[16523.881443, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[16523.882765, "o", "\r\nTASK [Configure Runner for jobs on Debian without Docker] *******************************************************************\r\n"]
[16524.121154, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[16524.121991, "o", "\r\nTASK [Write Gitea Runner Systemd service] ***********************************************************************************\r\n"]
[16524.356072, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
