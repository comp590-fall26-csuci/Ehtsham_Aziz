[16498.875616, "o", "-rw-rw---- 1 gitea-runner gitea-runner 459 Nov 13 03:36 /var/lib/gitea-runner/.runner\r\n"]
[16498.877471, "o", "\u001b[?2004h\u001b]0;ehtsham@Debian-arm-Lab: ~/Ehtsham_Aziz/Lab7\u0007\u001b[01;32mehtsham@Debian-arm-Lab\u001b[00m:\u001b[01;34m~/Ehtsham_Aziz/Lab7\u001b[00m$ "]
[16509.346353, "o", "sudo ls -l /var/lib/gitea-runner/.runner"]
[16509.609881, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b-u gitea-runner -H /usr/local/bin/gitea-runner --config /etc/gitea-runner/config.yaml register --no-interactive --instance http://127.0.0.1:3000 --token-file /var/lib/gitea-runner/.registration-token --name debian-arm64-runner --labels debian-host:host"]
[16509.954813, "o", "\u001b[A\u001b[A\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[Cbash -C '                                                   cd /var/lib//gitea-runner &&                                                                                                 H\u001b[23POME=/var/lib/gitea-runner \\\r\n\r/usr/local/bin/gitea-runner \\\r\n\r   --config /etc/gitea-runner/config.yaml \\\r\n\r   register \\\r\n\r   --no-interactive \\\r\n\r   --instance http://127.0.0.1:3000 \\\r\n\r   --token-file /var/lib/gitea-runner/.registration-token \\\r\n\r   --name debian-arm64-runner \\\r\n\r   --labels  debian-host:host\r\n\r' 2>&1 | sed -E 's/[A-Za-z0-9_=-]{30,}/[REACTED]/g'"]
[16510.33903, "o", "\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\b\b\b\b\b\b\bansible-playbook -i hosts.ini playbook.yml --ask-become-pass\r\n\r\u001b[K\r\n\r\u001b[K\r\n\r\u001b[K\r\n\r\u001b[K\r\n\r\u001b[K\r\n\r\u001b[K\r\n\r\u001b[K\r\n\r\u001b[K\r\n\r\u001b[K\r\n\r\u001b[K\r\n\r\u001b[K\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C"]
[16511.462622, "o", "\r\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[Csudo -v\u001b[K"]
