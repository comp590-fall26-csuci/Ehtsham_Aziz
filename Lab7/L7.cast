[14542.573156, "o", "\r\nTASK [Create Runner Directories] ********************************************************************************************\r\n"]
[14542.713267, "o", "\u001b[0;32mok: [localhost] => (item=/var/lib/gitea-runner)\u001b[0m\r\n"]
[14542.836973, "o", "\u001b[0;32mok: [localhost] => (item=/var/lib/gitea-runner/work)\u001b[0m\r\n"]
