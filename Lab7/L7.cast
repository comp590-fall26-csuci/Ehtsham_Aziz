[11010.967598, "o", "\r\nPLAY [Lab7 - Install Gitea and Gitea Runner on Debian] **********************************************************************\r\n"]
[11010.974554, "o", "\r\nTASK [Verify debian ARM64 system] *******************************************************************************************\r\n"]
[11011.173874, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[11011.175147, "o", "\r\nTASK [Install dependencies for Gitea and Fibonacci jobs] ********************************************************************\r\n"]
[11012.202768, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[11012.203401, "o", "\r\nTASK [Create git service user] **********************************************************************************************\r\n"]
[11012.431384, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[11012.432035, "o", "\r\nTASK [Create runner service user] *******************************************************************************************\r\n"]
[11012.582323, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[11012.582886, "o", "\r\nTASK [Create Gitea Data Directories] ****************************************************************************************\r\n"]
[11012.764944, "o", "\u001b[0;32mok: [localhost] => (item=/var/lib/gitea)\u001b[0m\r\n"]
[11012.890114, "o", "\u001b[0;32mok: [localhost] => (item=/var/lib/gitea/custom)\u001b[0m\r\n"]
