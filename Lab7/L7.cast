[5655.465806, "o", "\r\u001b[2d\u001b(B\u001b[0;1m\u001b[33m- \u001b(B\u001b[0m\u001b[92mname\u001b[39m: \u001b(B\u001b[mLab7 - Install Gitea and Gitea Runner on Debian\u001b[3;3H\u001b[92mhosts\u001b[39m: \u001b(B\u001b[mall\u001b[4;3H\u001b[92mbecome\u001b[39m: \u001b[95mtrue\u001b[5;3H\u001b[92mgather_facts\u001b[39m: \u001b[95mtrue\u001b[7;3H\u001b[92mvars\u001b[39m:\u001b[8;5H\u001b[92mgitea_version\u001b[39m: \u001b[95m'28.3.0'\u001b[9;5H\u001b[92mrunner_version\u001b[39m: \u001b[95m'5.4.1'\u001b[10;5H\u001b[92mgitea_url\u001b[39m: \u001b[95m'https://127.0.0.1:3000'\u001b[12;3H\u001b[92mtasks\u001b[39m:\r\u001b[13d\u001b(B\u001b[0;1m\u001b[33m  - \u001b(B\u001b[0m\u001b[92mname\u001b[39m: \u001b(B\u001b[mConfirm Debian\u001b[14;5H\u001b[92mansible.builtin.assert\u001b[39m:\u001b[15;7H\u001b[92mthat\u001b[39m:\u001b[16;8H\u001b(B\u001b[0;1m\u001b[33m\u001b[1K - \u001b[39m\u001b(B\u001b[mansible_distribution == \u001b[95m'Debian'\u001b[17;8H\u001b(B\u001b[0;1m\u001b[33m\u001b[1K - \u001b[39m\u001b(B\u001b[mansible_distribution_major_version | int >=12\u001b[18;8H\u001b(B\u001b[0;1m\u001b[33m\u001b[1K - \u001b[39m\u001b(B\u001b[manisble_architecture == \u001b[95m'aarch64'\u001b[19;7H\u001b[92mfail_msg\u001b[39m: \u001b[95m'This playbook needs Debian 12 or newer'\r\u001b[20d\u001b[39m\u001b[41m  \r\u001b[21d"]
